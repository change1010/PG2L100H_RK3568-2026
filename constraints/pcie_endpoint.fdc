create_clock -name {pcie_pclk} [get_pins {u_pcie_ram_endpoint.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.pclk}] -period {4.000} -waveform {0.000 2.000}
create_clock -name {pcie_pclk_div2} [get_pins {u_pcie_ram_endpoint.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY.pclk_div2}] -period {8.000} -waveform {0.000 4.000}
create_clock -name {pcie_ref_clk} [get_pins {u_pcie_ram_endpoint.u_ips2l_pcie_wrap.U_IPS2L_PCIE_TOP.U_IPS2L_HSSTLP_PCIE_SOFT_PHY/P_REFCK2CORE_0}] -period {10.000} -waveform {0.000 5.000}

set_clock_groups -name pcie_pclk_group -asynchronous -group [get_clocks {pcie_pclk}]
# pix/PCIe div2 group is declared in dark_enhance.fdc, after both clocks exist.
set_clock_groups -name pcie_ref_clk_group -asynchronous -group [get_clocks {pcie_ref_clk}]

